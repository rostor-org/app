[Unit]
Description=Rostor core
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=rostor
Group=rostor
EnvironmentFile=/etc/rostor/env
ExecStart=/usr/local/bin/rostor serve
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/rostor
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
